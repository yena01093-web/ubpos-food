# ── Database (Supabase) ──────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32chars
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 나이스페이먼츠 ───────────────────────────────────
# 샌드박스
NICE_CLIENT_KEY=nicepay00m
NICE_SECRET_KEY=nicepay00m
NICE_MID=nicepay00m
# 운영 (계약 완료 후 교체)
# NICE_CLIENT_KEY=yena01093m
# NICE_SECRET_KEY=[운영 시크릿키]
# NICE_MID=yena01093m

NICE_API_URL=https://sandbox-api.nicepay.co.kr
# 운영: https://api.nicepay.co.kr

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── 바로고 배달 ──────────────────────────────────────────
BAROGO_API_URL=https://api.barogo.com
BAROGO_API_KEY=your_barogo_api_key
BAROGO_API_SECRET=your_barogo_api_secret
BAROGO_WEBHOOK_SECRET=your_webhook_secret

# ── 카카오 알림톡 (Solapi) ───────────────────────────────
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
KAKAO_SENDER_KEY=your_kakao_pfid        # 카카오채널 발신프로필 키
SENDER_PHONE=0431234567                 # 대표 발신번호

# 알림톡 템플릿 ID (Solapi 콘솔에서 등록 후 발급)
KAKAO_TMPL_ORDER_ACCEPTED=your_template_id
KAKAO_TMPL_ORDER_READY=your_template_id
KAKAO_TMPL_DELIVERY_ASSIGNED=your_template_id
KAKAO_TMPL_DELIVERY_DONE=your_template_id
KAKAO_TMPL_ORDER_CANCELLED=your_template_id

# ── WS 서버 ──────────────────────────────────────────────
WS_PORT=3001
WS_INTERNAL_URL=http://localhost:3001
EMIT_SECRET=emit_dev_secret
NEXT_PUBLIC_WS_URL=http://localhost:3001
